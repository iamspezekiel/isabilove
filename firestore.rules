rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);

      // Contacts Subcollection
      match /contacts/{contactId} {
        allow read, write: if isValidId(userId) && isValidId(contactId) && isOwner(userId);
      }

      // Reminders Subcollection
      match /reminders/{reminderId} {
        allow read, write: if isValidId(userId) && isValidId(reminderId) && isOwner(userId);
      }

      // Drafts Subcollection
      match /drafts/{draftId} {
        allow read, write: if isValidId(userId) && isValidId(draftId) && isOwner(userId);
      }
    }
  }
}
